# Copiar a .env.local y completar. Nunca commitear .env.local.

# Postgres. En local apunta al contenedor de docker-compose.yml.
# En producción, la cadena de Neon (usar el endpoint con pooler para serverless).
DATABASE_URL="postgres://loadout:loadout@localhost:5433/loadout"

# Base de datos que usan los tests. Se recrea en cada corrida, así que
# NUNCA debe apuntar a la misma que DATABASE_URL ni a producción.
TEST_DATABASE_URL="postgres://loadout:loadout@localhost:5433/loadout_test"

# Clave de cifrado de códigos (AES-256-GCM). 32 bytes en base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde, los códigos ya cargados son irrecuperables.
CODE_ENCRYPTION_KEY=""

# Pimienta del huella de deduplicación (HMAC-SHA256). 32 bytes en base64.
# Distinta de la anterior: separa "poder deduplicar" de "poder descifrar".
CODE_FINGERPRINT_KEY=""

# Origen público del sitio. Arma las URLs de retorno/redirect que se le
# pasan a Wompi y PayPal — en dev, el túnel o localhost:3000.
APP_URL="http://localhost:3000"

# ── Wompi (fase 5/7) — Colombia, COP ─────────────────────────────────────
# WOMPI_API_URL es OBLIGATORIA (fase 7: antes caía en silencio a producción
# si faltaba). Tiene que coincidir con el par de claves que uses — Wompi no
# valida claves de un ambiente contra la API del otro, solo responde 401:
#
#   Sandbox (desarrollo/pruebas):
#     WOMPI_API_URL="https://sandbox.wompi.co/v1"
#     claves con prefijo  pub_test_ / prv_test_
#
#   Producción:
#     WOMPI_API_URL="https://production.wompi.co/v1"
#     claves con prefijo  pub_prod_ / prv_prod_
#
# El checkout alojado (checkout.wompi.co/p/) es la misma URL en los dos
# casos — el ambiente lo determina la public key, no el dominio del widget.
WOMPI_API_URL=""
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
# Firma de integridad al crear una transacción (checkout alojado). Distinta
# de la de abajo — ver comentario de cabecera en wompi-client.ts. Un par
# distinto por ambiente (sandbox tiene el suyo, producción el suyo).
WOMPI_INTEGRITY_SECRET=""
# Firma de verificación de webhooks ("eventos"). Se configura en el
# dashboard de Wompi junto con la URL del webhook — también un par por ambiente.
WOMPI_EVENTS_SECRET=""

# ── PayPal (fase 5/7) — internacional, USD ───────────────────────────────
# PAYPAL_API_URL es OBLIGATORIA (fase 7: antes caía en silencio a
# producción si faltaba). A diferencia de Wompi, PayPal no tiene un dominio
# de checkout separado por ambiente — la `approvalUrl` sale de la propia
# respuesta de la API, así que esta es la única variable que decide el
# ambiente:
#
#   Sandbox (developer.paypal.com → app "Sandbox"):
#     PAYPAL_API_URL="https://api-m.sandbox.paypal.com"
#
#   Producción (developer.paypal.com → app "Live"):
#     PAYPAL_API_URL="https://api-m.paypal.com"
#
# Client ID/Secret y Webhook ID son de la MISMA app — no se puede mezclar
# credenciales sandbox con la app live ni viceversa.
PAYPAL_API_URL=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Id del webhook configurado en el dashboard de PayPal — lo pide su propia
# API de verificación de firma (POST /v1/notifications/verify-webhook-signature).
# Sandbox y producción tienen suscripciones de webhook DISTINTAS, cada una
# con su propio id — no reutilizar el mismo entre ambientes.
PAYPAL_WEBHOOK_ID=""

# Tasa de cambio COP→USD para pagos con PayPal. TRADE-OFF EXPLÍCITO: no hay
# proveedor de tipo de cambio en vivo conectado todavía — esto es un valor
# fijo hasta que se decida y conecte una fuente real antes de producción.
USD_COP_EXCHANGE_RATE="4000"

# ── Storage / CDN de imágenes del admin ──────────────────────────────────
# Vercel Blob — usado por /api/admin/upload para subir banners/imágenes de
# producto desde el admin y servirlos por CDN, en vez de pegar una URL a
# mano. Se obtiene sin necesidad de deployar todavía:
#   1. vercel.com → tu cuenta → Storage → Create Database → Blob.
#   2. En la raíz del repo: `npx vercel link` (crea/asocia el proyecto),
#      después `npx vercel env pull .env.local` trae el token acá solo.
# Sin esta variable, el endpoint de upload responde 503 (no rompe nada,
# pero el campo de URL manual sigue funcionando igual mientras tanto).
BLOB_READ_WRITE_TOKEN=""

# ── Cron externo (fase 8) ────────────────────────────────────────────────
# Secreto que protege /api/cron/*. El hosting (Vercel) no corre nada por sí
# solo entre requests — un scheduler externo gratuito (cron-job.org,
# EasyCron, GitHub Actions cron, etc.) le pega a estas URLs cada cierto
# tiempo. Sin CRON_SECRET configurada, esas rutas devuelven 401 siempre —
# nunca quedan "abiertas por accidente" si alguien se olvida de setearla.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# El scheduler manda el secreto como header `Authorization: Bearer <valor>`
# (preferido) o, si esa herramienta no deja mandar headers custom, como
# query param `?secret=<valor>` en la URL configurada.
#
# Endpoints y frecuencia recomendada:
#   POST/GET /api/cron/sweep               cada 1-2 min
#   POST/GET /api/cron/refund-worker       cada 1-2 min
#   POST/GET /api/cron/reconcile-payments  cada 5 min
CRON_SECRET=""

# ── Email (Resend) ───────────────────────────────────────────────────────
# Sin RESEND_API_KEY, `mailer.ts` cae al mock (imprime en consola en dev,
# solo loguea el error en producción) — nada se rompe, pero no sale nada
# de verdad. Conseguí una key gratis en resend.com (hasta 3000 emails/mes).
# EMAIL_FROM necesita un dominio verificado en Resend para producción; para
# probar sin verificar dominio, dejalo vacío y usa el remitente sandbox
# por defecto (onboarding@resend.dev — solo entrega a la cuenta dueña de
# la API key).
RESEND_API_KEY=""
EMAIL_FROM=""
